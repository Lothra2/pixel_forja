            "weapon_throw",
            "umbrella_block",
            "fan_gust",
            "stomp",
            "grab_throw",
            "knee_hit_react",
            "back_elbow",
            "dash",
            "dash_back",
            "headbutt",
            "eat",
            "edge_teeter",
            "fall_off",
            "taunt_rick",
            "taunt_steph",
            "taunt_sophie",
            "taunt_alana",
            "taunt_kenji",
            "taunt_ryu",
            "taunt_goro",
            "taunt_tetsu",
            "victory_rick",
            "victory_steph",
            "victory_sophie",
            "victory_alana",
            "victory_kenji",
            "victory_ryu",
            "victory_goro",
            "victory_tetsu",
            "ladder",
            "climb_wall",
            "ledge_hang",
            "pull_up",
            "balance_walk",
            "balance_wobble",
            "balance_fall",
            "duck_run",
            "bike_fast",
            "bike_crash",
            "skate_crash",
            "climb_pole",
            "pole_idle",
            "pole_punch",
            "pole_slide",
            "pole_kick_down",
            "pole_shake",
            "grab_leg_up",
            "swim",
            "swim_back",
            "swim_breast",
            "swim_fly",
            "tread_water",
            "swim_exit",
            "attack",
            "throw",
            "block_shield",
            "use_item",
            "die",
            "cast",
            "nova",
            "channel",
            "whirlwind",
            "leap",
            "charge",
            "dodge",
            "shoot_bow",
            "summon",
            "warcry",
            "attack_heavy",
            "attack_thrust",
            "zombie_walk",
            "claw",
            "lunge",
            "rise"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "description": "Cada pack es un atlas por atleta: { \"base\": [\"idle\", \"walk\", \"run\"] }."
    },
    "pruebas": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "description": "Qué packs carga cada prueba del juego. Se copia al manifiesto."
    },
    "retratos": {
      "type": "boolean",
      "description": "Retratos de 8 expresiones en 40 y 96. Sin valor: sí."
    },
    "cabecitas": {
      "type": "boolean",
      "description": "Cabecitas de 12 x 12 para el minimapa. Sin valor: sí."
    },
    "objetos": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "enum": [
              "chancleta",
              "silla_plastica",
              "non_la",
              "coco",
              "tubo",
              "llanta",
              "pote_basura",
              "cono",
              "escoba",
              "piedra",
              "paraguas",
              "abanico",
              "termo",
              "furro",
              "broomstick",
              "balon_goma",
              "chapa",
              "tejo",
              "volante_dacau",
              "arepa",
              "tequeno",
              "empanada",
              "banh_mi",
              "pan_de_bono",
              "comida"
            ]
          },
          "uniqueItems": true
        }
      ],
      "description": "Armas del piso y comida de la pelea (peso \"comida\", con humito): true = todo, o la lista. \"comida\" pide toda la comida."
    },
    "animales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "uniqueItems": true,
      "description": "Animales: los de las fichas y thor, que trae el motor."
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fuentes": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idiomas": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "es",
                      "en",
                      "vi"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            }
          ],
          "description": "Las tres fuentes bitmap (con vietnamita) en ui/fuentes."
        },
        "logo": {
          "type": "object",
          "required": [
            "texto"
          ],
          "properties": {
            "texto": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "El logo animado del juego a partir de su nombre, en 320 x 112 y 160 x 56 (ui/logo.png y ui/logo_chico.png)."
        },
        "interfaz": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "dialogo",
                  "paneles",
                  "barras",
                  "marcos",
                  "banners",
                  "controles",
                  "minimapa",
                  "numeros"
                ]
              },
              "uniqueItems": true
            }
          ],
          "description": "Piezas de interfaz retro en ui/: caja de diálogo, paneles por equipo, barras, marcos de retrato, banners, controles táctiles, minimapa y números de marcador. true = todas."
        },
        "vs_fondo": {
          "type": "boolean",
          "description": "La pantalla del VS: el fondo con los colores de cada par de equipos partidos en diagonal y rayos (ui/vs/), uno neutro, y las letras VS aparte para estrellarlas."
        }
      }
    },
    "escenarios": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      ],
      "description": "Carpeta con los *.layout.json (\"data/stages/\") o la lista de layouts. Cada uno sale en escenarios/<id>/ con sus capas, objetos, vida, superficie y colisión, y pasa por las 9 pruebas. Ver docs/ESCENARIOS.md."
    },
    "fx": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "polvo_correr_chico",
                  "polvo_correr_medio",
                  "polvo_correr_grande",
                  "polvo_frenar_chico",
                  "polvo_frenar_medio",
                  "polvo_frenar_grande",
                  "polvo_caer_chico",
                  "polvo_caer_medio",
                  "polvo_caer_grande",
                  "chispa_golpe_liviano",
                  "chispa_golpe_medio",
                  "chispa_golpe_pesado",
                  "estrellas_mareo",
                  "nube_ko",
                  "vena_enojo",
                  "gota_nervios",
                  "sonrojo",
                  "exclamacion",
                  "interrogacion",
                  "lagrima_comica",
                  "sudor",
                  "chapuzon_chico",
                  "chapuzon_grande",
                  "estela",
                  "ondas",
                  "confeti",
                  "serpentina",
                  "fuegos_artificiales_rojo",
                  "fuegos_artificiales_azul",
                  "fuegos_artificiales_dorado",
                  "fuegos_artificiales_verde",
                  "bola_tama",
                  "bola_tama_explota",
                  "bola_tama_cartel",
                  "mecha_tejo",
                  "estela_chapa",
                  "ventana_rota",
                  "pantalla_rota",
                  "lineas_velocidad",
                  "marco_corte",
                  "lluvia",
                  "salpicadura_piso",
                  "onda_charco",
                  "relampago",
                  "calor",
                  "rayo_catatumbo",
                  "onda_furro",
                  "rafaga_abanico",
                  "vapor_termo",
                  "aura_nekketsu",
                  "humo_moto",
                  "petalo_buganvilla",
                  "hoja",
                  "arena",
                  "brillo_record",
                  "huella_mojada",
                  "onomatopeya_pow",
                  "onomatopeya_paf",
                  "onomatopeya_crack",
                  "onomatopeya_nam",
                  "ko_grande",
                  "bloqueo",
                  "agarre",
                  "polvo_correr",
                  "polvo_frenar",
                  "polvo_caer",
                  "chispa_golpe",
                  "chapuzon",
                  "fuegos_artificiales",
                  "onomatopeya",
                  "polvo",
                  "golpe",
                  "reaccion",
                  "agua",
                  "fiesta",
                  "objetos",
                  "pantalla",
                  "clima",
                  "tecnica",
                  "ambiente"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "uniqueItems": true
        }
      ],
      "description": "Efectos del catálogo general en fx/: true = todos, o ids, bases (polvo_correr = sus 3 tamaños) y grupos (polvo, golpe, reaccion, agua, fiesta, objetos, pantalla, clima, tecnica, ambiente). Ver docs/EFECTOS.md."
    },
    "audio": {
      "type": "object",
      "description": "Sonidos sintetizados del motor en audio/sfx, audio/musica y audio/ambiente. Los nombres que todavía no existen vuelven como aviso: llegan con el lote H.",
      "properties": {
        "formato": {
          "enum": [
            "wav",
            "comprimido"
          ],
          "description": "\"wav\" (por defecto): un WAV por sonido y \"archivo\" es un texto. \"comprimido\": OGG Vorbis y M4A (AAC) en mono, música a 64 kbps, ambientes a 48 y efectos a 64, y \"archivo\" es la lista [ogg, m4a] para que el juego cargue el que su navegador toque. Necesita ffmpeg en la máquina que arma el kit: sin ffmpeg los efectos salen en WAV ([\"x.wav\"]) y la música y los ambientes quedan en manifest.pendiente. Las voces siempre van en WAV."
        },
        "sfx": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "espadazo",
                      "golpe",
                      "critico",
                      "enemigo_dolor",
                      "enemigo_muere",
                      "jefe_rugido",
