                      "click",
                      "abrir_inventario",
                      "error",
                      "jugador_dolor",
                      "magia",
                      "descubrir",
                      "secreto",
                      "elegir",
                      "guardado",
                      "arco",
                      "esquiva",
                      "bloqueo",
                      "thor_rescate",
                      "paso_pasto_0",
                      "paso_pasto_1",
                      "paso_pasto_2",
                      "paso_tierra_0",
                      "paso_tierra_1",
                      "paso_tierra_2",
                      "paso_piedra_0",
                      "paso_piedra_1",
                      "paso_piedra_2",
                      "paso_madera_0",
                      "paso_madera_1",
                      "paso_madera_2",
                      "paso_agua_0",
                      "paso_agua_1",
                      "paso_agua_2",
                      "pistola",
                      "silbato",
                      "golpe_1",
                      "golpe_2",
                      "golpe_3",
                      "golpe_pesado",
                      "chancleta",
                      "silla",
                      "pote",
                      "levantar",
                      "lanzar",
                      "caer_plano",
                      "mareo",
                      "ko",
                      "publico_grito",
                      "publico_ooh"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "uniqueItems": true
            }
          ]
        },
        "musica": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "bosque",
                      "jefe",
                      "victoria",
                      "titulo",
                      "marcha_nekketsu",
                      "saigon_chay",
                      "azotea_final",
                      "victoria_banda",
                      "derrota"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "uniqueItems": true
            }
          ]
        },
        "ambientes": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "bosque",
                      "agua",
                      "noche",
                      "viento",
                      "cueva",
                      "magia"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "uniqueItems": true
            }
          ]
        },
        "voces": {
          "description": "Voces en blips para los diálogos: true = todos los atletas, una lista de ids (atletas o NPC como \"locutor\"), o { id: { tono, timbre } }.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "uniqueItems": true
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tono": {
                    "type": "number",
                    "minimum": 0.3,
                    "maximum": 3
                  },
                  "timbre": {
                    "enum": [
                      "cuadrada",
                      "aguda",
                      "triangulo",
                      "sierra"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "publico": {
      "type": "object",
      "description": "El público. \"azoteas\": la gente asomada en las azoteas vecinas de la pelea, en publico/azoteas.png (de día) y publico/azoteas_noche.png, con los estados quieto, celebra y abuchea. Los hinchas por país (paises, variantes) llegan con el lote C6 y vuelven como aviso.",
      "properties": {
        "azoteas": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ancho": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2048
                },
                "gente": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2048
                }
              }
            }
          ]
        }
      }
    },
    "vehiculos": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "ferry",
                  "xich_lo",
                  "moto_rojo",
                  "moto_azul",
                  "moto_amarillo",
                  "moto_verde",
                  "bote_bambu",
                  "metrocable",
                  "jacintos",
                  "frutas_regadas",
                  "moto"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "uniqueItems": true
        }
      ],
      "description": "Vehículos y objetos de escenario en la vista inclinada (px = x + 0.35 y), en vehiculos/<id>.png: una tira de cuadros con sus animaciones, el ancla (la esquina de atrás a la izquierda de la huella, en el piso) y la huella. true = todos, o ids (\"moto\" = los 4 colores). Los que todavía no existen vuelven como aviso."
    },
    "npc": {
      "description": "Todavía no se genera: se acepta y vuelve como aviso en manifest.pendiente. Llega con NPC (lote C6)."
    }
  }
}
